# =============================================================================
# deploy/authentik/.env.example
# Copy this to .env and fill in real values before running docker compose.
# Generate secrets with: openssl rand -hex <bytes>
# Hex is required — base64 output can wrap across lines and corrupt .env.
# =============================================================================

# PostgreSQL password for the Authentik database user.
# Used by both the postgres container (POSTGRES_PASSWORD) and the Authentik
# server/worker (AUTHENTIK_POSTGRESQL__PASSWORD).
# Generate: openssl rand -hex 24
# WARNING: changing this after the database volume exists will break startup.
# To rotate: docker compose down -v, update this value, docker compose up -d.
PG_PASS=

# Authentik secret key — used for signing sessions, tokens, and cookies.
# Must be a long random string. Never reuse across environments.
# Generate: openssl rand -hex 48
AUTHENTIK_SECRET_KEY=

# =============================================================================
# PlatformOps CLI env vars (not used by docker compose — set in your shell
# before running: uv run python -m gateway.auth.cli)
# =============================================================================

# OIDC issuer URL for the PlatformOps application in Authentik.
# Format: http://localhost:9000/application/o/<slug>/
# Find the slug: Admin UI → Applications → Applications → your app
# (also visible in the browser URL: #/core/applications/<slug>)
# Example: PLATFORMOPS_OIDC_ISSUER=http://localhost:9000/application/o/platform-ops/
# PLATFORMOPS_OIDC_ISSUER=

# OAuth2 Client ID for the PlatformOps provider.
# Find it: Admin UI → Applications → Providers → PlatformOps Provider → Client ID
# It is a UUID, e.g. a1b2c3d4-e5f6-...
# PLATFORMOPS_OIDC_CLIENT_ID=

# Path to the YAML file that maps Authentik groups to PlatformOps approval grants.
# Use the bundled example for local smoke testing:
# PLATFORMOPS_GRANT_MAPPING=$PWD/deploy/authentik/grants.example.yaml
# PLATFORMOPS_GRANT_MAPPING=

# Where the CLI writes the token-free session after login.
# The directory is created automatically. Do not commit this file.
# PLATFORMOPS_SESSION_PATH=$PWD/.platformops/session.json
# PLATFORMOPS_SESSION_PATH=
