# Copy to .env and fill in — never commit the real .env file
AWS_PROFILE=platformops-sandbox
AWS_REGION=us-east-1
GOOGLE_API_KEY=
# Set to a low number; the MCP server refuses actions above this estimated monthly cost (USD)
MAX_ESTIMATED_MONTHLY_COST_USD=5

# transports/http.py's model provider -- see workflows/intake/graph.py's
# build_intake_graph docstring for why no default is chosen in code
ANTHROPIC_API_KEY=
# Optional; defaults to claude-haiku-4-5 if unset (see transports/http.py)
PLATFORMOPS_ANTHROPIC_MODEL=

# gateway/auth/cli.py's device-code login (platformops login) -- see
# docs/INTERACTION_LAYER.md's TUI-first/device-code decision
PLATFORMOPS_OIDC_ISSUER=
PLATFORMOPS_OIDC_CLIENT_ID=
PLATFORMOPS_OIDC_AUDIENCE=
PLATFORMOPS_GRANT_MAPPING=
# Defaults to .platformops/session.json if unset; also read by
# transports/http.py to find the same on-disk session
PLATFORMOPS_SESSION_PATH=
